DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
# true, когда сайт открывается по HTTPS (на сервере)
DJANGO_SECURE_COOKIES=false

POSTGRES_DB=churn
POSTGRES_USER=churn
POSTGRES_PASSWORD=churn
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

METRICS_TOKEN=change-me

# Чем заполнить пустую базу при старте: extended (кейс + демо), case, none
SAMPLE_AUTOLOAD=extended

# Вход через SSO. Для встроенного Keycloak раскомментируйте COMPOSE_PROFILES,
# включите OIDC_ENABLED и задайте секреты ниже любыми случайными строками.
# Пользователей заводят в «Админке» панели, они копируются в Keycloak;
# первый вход по паролю, дальше через SSO с ключом FIDO2 или passkey.
#COMPOSE_PROFILES=oidc
OIDC_ENABLED=false
OIDC_PUBLIC_URL=http://localhost:8080
OIDC_CLIENT_SECRET=change-me
KEYCLOAK_PROVISIONER_SECRET=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
